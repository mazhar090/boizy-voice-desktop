
{
  "name": "voicechat-desktop",
  "version": "1.0.0",
  "description": "Windows desktop application for VoiceChat",
  "main": "main.js",
  "author": "VoiceChat",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.voicechat.desktop",
    "productName": "VoiceChat",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mazhar090",
        "repo": "boizy-voice-desktop",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**/*",
      "README.txt"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VoiceChat"
    }
  }
}
